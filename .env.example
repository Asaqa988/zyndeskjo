# ─────────────────────────────────────────────────────────────
# Zyndesk website environment variables
# Copy to `.env.local` and fill in. All NEXT_PUBLIC_* vars are
# exposed to the browser.
# ─────────────────────────────────────────────────────────────

# Canonical site URL (no trailing slash). Used for metadata, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=https://zyndeskjo.com

# Where the multi-step lead form POSTs. Leave blank to use the built-in
# /api/lead mock endpoint (logs to server console + returns success).
# Point this at your CRM / webhook / email service in production.
LEAD_WEBHOOK_URL=

# Optional: simple shared secret sent as `x-zyndesk-token` with lead posts.
LEAD_WEBHOOK_TOKEN=

# Meta (Facebook) Pixel ID — enables ad retargeting + conversion tracking.
# Get it from Events Manager (business.facebook.com/events_manager) → Data sources.
# Leave blank to keep the pixel completely off.
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics 4 Measurement ID (looks like G-XXXXXXXXXX).
# Get it from analytics.google.com → Admin → Data streams. Blank = GA off.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token (the content="..." value from the
# "HTML tag" verification method). Renders <meta name="google-site-verification">.
NEXT_PUBLIC_GSC_VERIFICATION=
